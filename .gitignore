# ============================================================
# 行情缓存 / 中间产物：每次刷新都会变，可随时重新抓取
# 全量入库会把真实的代码改动淹没在几万行 diff 里
# ============================================================
# 注意：父目录被排除后，子文件无法用 ! 直接放行，必须逐级打开。
# /data/apac/ 整目录不入库——它没有「错过当天就永久缺失」的累积资产，
# 五地日线与恒指缓存都可随时重抓，与 short_archive.json 的性质不同。
/data/*
!/data/us_senti/
/data/us_senti/*
!/data/us_senti/fng_archive.json
!/data/hk_senti/
/data/hk_senti/*
!/data/hk_senti/short_archive.json

# 市场总览：config.json 是用户资产（资产清单、自选股、板块归类），brief.json 是逐日写下的
# 判断文字，两者都要入库；行情与分时缓存 market.json 不入库。
!/data/market/
/data/market/*
!/data/market/config.json
!/data/market/brief.json

# 最新风向：已发表的公开观点是累积资产——某次访谈三个月后可能就搜不到了，
# 丢了要重新检索。所以 wind.json 与分块草稿 part*.json 全部入库。
!/data/wind/
/data/wind/*
!/data/wind/wind.json
!/data/wind/part*.json

# 机构研报：与 wind 同理，论据与出处都是人写的，属于累积资产；主题与机构定义
# 也在同一文件里，丢了要重建整套口径。
!/data/research/
/data/research/*
!/data/research/research.json

# 财经日历：事件是人查证后写下的策展内容（日期、出处、确认度），
# 不是抓来的行情；丢了要重新检索几十个源，必须入库。
!/data/calendar/
/data/calendar/*
!/data/calendar/calendar.json

# 个人笔记：notes.json 里没有一行是程序能重新生成的——都是人一个字一个字写下的。
# 它是全项目最不可替代的文件（行情丢了重抓、笔记丢了没有第二份），必须入库。
# backups/ 同样不入库：每次写盘前的旧版副本，git 历史本身就是更好的版本记录。
!/data/notes/
/data/notes/*
!/data/notes/notes.json

# 大佬持仓：holdings.json 是 SEC 13F 的快照（申报时点的公开数据，可重抓），
# 但有它才能在没有网的时候打开页面看到内容，且「上一期是什么样」是后面做
# 季度变化的唯一依据，所以入库。缓存目录与临时 XML 不入库。
!/data/holdings/
/data/holdings/*
!/data/holdings/holdings.json

# 持仓地图：matrix.json 是用户手填的分组与仓位备注，整份都是累积资产——
# 卡片删了就找不回来，且历史版本的「当时怎么配的」只能靠它。必须入库。
!/data/portfolio/
/data/portfolio/*
!/data/portfolio/matrix.json
# backups/ 是每次写盘前的旧版副本（滚动 30 份），只用于本地回滚，不入库：
# git 里的 matrix.json 历史本身就是更完整的版本记录，再存一份只会放大 diff 噪音。

# 市场新闻：issue*.json 是编好的稿子（分桶、头条与「为什么重要」都是判断文字，
# 程序造不出来），必须入库；raw.json 是抓取原料，每次都在变，随时可重抓，不入库。
!/data/news/
/data/news/*
!/data/news/news.json
!/data/news/issue*.json

# 运行日志
/data/server.log*

# ============================================================
# 构建产物：由 scripts/build_dashboard.py 从 tpl.html 注入数据生成
# ============================================================
/output/

# ============================================================
# WorkBuddy 会话数据（非项目内容）
# ============================================================
/.workbuddy/

# ============================================================
# 临时检查目录：语法校验、截图中间产物，用完即删
# （v1.4.2 曾误提交 .tmpchk/b1.js，从此固定忽略）
# ============================================================
.tmpchk/
.tmp/

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/

# ============================================================
# 编辑器 / 系统
# ============================================================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
